# Solo servidor. Copia a server/.env en TU equipo y chmod 600.

# Proveedor de modelos de Strands Agents (ver server/PROVIDERS.md):
# vercel (defecto) | openai | anthropic | google | bedrock |
# openrouter | fireworks | nebius | ovhcloud | crusoe | orcarouter
TURNO_AI_PROVIDER=vercel
# Clave del proveedor elegido (solo la que uses; nunca en el frontend):
# OPENAI_API_KEY= / ANTHROPIC_API_KEY= / GOOGLE_API_KEY= / OPENROUTER_API_KEY=
# FIREWORKS_API_KEY= / NEBIUS_API_KEY= / OVHCLOUD_API_KEY= / CRUSOE_API_KEY= / ORCAROUTER_API_KEY=
# Bedrock: credenciales AWS estándar o AWS_BEARER_TOKEN_BEDROCK, más AWS_REGION.

# No poner claves en el frontend, git, capturas, logs ni chats.
# Desplegado en Vercel: preferir OIDC y dejar AI_GATEWAY_API_KEY sin configurar.
# Fuera de Vercel: API key de AI Gateway, guardada en secret manager.
AI_GATEWAY_API_KEY=

# Feature flag: no llamar modelos hasta autorizar piloto de datos sintéticos.
TURNO_AI_ENABLED=0
TURNO_SYNTHETIC_ONLY=1
# Vacío = modelo por defecto: anthropic/claude-haiku-5.5 (elegido en la evaluación real,
# ver server/DECIDER.md). Techo de precio del piloto: US$0,10 / 0,50 por millón de tokens.
TURNO_AI_MODEL_ID=
# Respaldo si el principal falla (Vercel AI Gateway, en orden). Por defecto:
# deepseek/deepseek-v4.1-flash (va por la clave BYOK de DeepSeek). Una cadena vacía lo desactiva,
# por eso queda comentado.
# TURNO_AI_FALLBACK_MODELS=deepseek/deepseek-v4.1-flash
# Solo Vercel. Opcional: restringir enrutamiento, p. ej. "openai" para usar tu credencial BYOK de OpenAI.
# Cuidado: también se aplica al respaldo, así que restringirlo a un proveedor puede dejarlo sin efecto.
TURNO_GATEWAY_ONLY=
# Solo modelos OpenAI con razonamiento (gpt-5+, gpt-6, o*), vía Vercel u OpenAI directo: none|minimal|low|medium|high.
TURNO_AI_REASONING_EFFORT=low

# Decider (sistema de Strands/Amazon, ver server/DECIDER.md).
# GATEWAY: solo el LLM. DUAL: el LLM decide y el decider se compara en paralelo.
# DECISION: solo el decider (el LLM queda para la captura de tareas).
TURNO_DECISION_MODE=GATEWAY
TURNO_DECISION_MODEL_ID=typesafe-ai/jev
# Bajo este umbral el decider se abstiene. 0 = aplica siempre su respuesta (ajustado con la corrida DUAL).
TURNO_DECISION_MIN_CONFIDENCE=0

# Endpoint HTTP interno (ver server/ENDPOINT.md). Secreto de firma HMAC del servicio:
# obligatorio con TURNO_AI_ENABLED=1 y mínimo 32 bytes. Generarlo en el secret manager
# (p. ej. `openssl rand -hex 32`); nunca en frontend, Git, logs ni chats.
TURNO_AGENT_SIGNING_SECRET=
# Opcionales del endpoint (valor por defecto entre paréntesis):
# TURNO_AGENT_HOST=127.0.0.1
# TURNO_AGENT_PORT=8787
# TURNO_AGENT_RATE_LIMIT=10
# TURNO_AGENT_TIMEOUT_MS=10000

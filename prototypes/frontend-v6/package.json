{
  "name": "turno-frontend-v6",
  "version": "0.1.0-phase1a",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4176",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint -c .oxlintrc.json --deny-warnings src tests scripts",
    "test:unit": "vitest run --project unit --maxWorkers=1 --no-file-parallelism",
    "test:component": "vitest run --project component --maxWorkers=1 --no-file-parallelism",
    "test:e2e": "playwright test --project=chromium --workers=1",
    "test:smoke:engines": "playwright test tests/e2e/smoke.spec.ts --project=firefox --project=webkit --workers=1",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4176",
    "check:portable": "node scripts/check-portable.mjs dist/preview.html",
    "measure:bundle": "node scripts/measure-bundle.mjs dist/preview.html",
    "check:parity": "node scripts/check-parity.mjs docs/parity-map.json",
    "test:tooling": "node --test tests/tooling/*.test.mjs",
    "build:e2e": "npm run build && node scripts/build-history-harness.mjs && node scripts/build-layout-harness.mjs",
    "pretest:e2e": "npm run build:e2e",
    "pretest:smoke:engines": "npm run build"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "clsx": "2.1.1",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "31.0.0",
    "oxlint": "1.92.0",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "4.1.12"
  }
}

# Copia este archivo a server/.env en TU equipo. Nunca pegues la clave en GitHub.
# Valor secreto: solo en el servidor, nunca en la interfaz.
OPENCODE_API_KEY=

# zen: OpenCode Zen; go: OpenCode Go
OPENCODE_MODE=zen
OPENCODE_MODEL_ID=glm-5.3

# Solo obligatorio cuando OPENCODE_MODE=go.
OPENCODE_SESSION_ID=

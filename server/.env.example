# Solo servidor. Copia a server/.env en TU equipo y chmod 600.
# No poner claves en el frontend, git, capturas, logs ni chats.
# Desplegado en Vercel: preferir OIDC y dejar AI_GATEWAY_API_KEY sin configurar.
# Fuera de Vercel: API key de AI Gateway, guardada en secret manager.
AI_GATEWAY_API_KEY=

# Feature flag: no llamar modelos hasta autorizar piloto de datos sintéticos.
TURNO_AI_ENABLED=0
TURNO_SYNTHETIC_ONLY=1
TURNO_AI_MODEL_ID=anthropic/claude-haiku-4.5
TURNO_DECISION_MODEL_ID=microsoft/microsoft-decision-1

# GATEWAY (Strands), DUAL (Strands activo + Decision API sombra), DECISION.
TURNO_DECISION_MODE=GATEWAY

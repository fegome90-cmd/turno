# SERVIDOR EXCLUSIVAMENTE; nunca copie este archivo al frontend.
# En Vercel, no necesitas una clave permanente si OIDC está habilitado.
# En un servidor externo, establece AI_GATEWAY_API_KEY como secreto de runtime.
AI_GATEWAY_API_KEY=
TURNO_AGENT_MODEL=google/gemini-2.5-flash
TURNO_DECISION_MODEL=typesafe-ai/jev
TURNO_AGENT_MODE=GATEWAY
# No configurar VERCEL_OIDC_TOKEN manualmente en producción.
